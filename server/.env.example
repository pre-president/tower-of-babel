# Copy to .env for local development ONLY. Never commit real .env files.
TOWER_ENV=development
TOWER_HOST=127.0.0.1
TOWER_PORT=8100

# PostgreSQL in production; SQLite supported for local smoke testing
DATABASE_URL=postgresql+psycopg://tower_hub:CHANGE_ME@127.0.0.1:5432/tower_hub

# Replace all placeholder tokens with strong random values in production
TOWER_BRIDGE_TOKEN=replace-with-strong-bridge-token
TOWER_AGENT_TOKEN_GEMINI=replace-with-strong-gemini-token
TOWER_AGENT_TOKEN_DEEPSEEK=replace-with-strong-deepseek-token
TOWER_AGENT_TOKEN_GPT=replace-with-strong-gpt-token
# Optional extensible tokens map for additional open-source execution agents (JSON or actor=token CSV)
TOWER_AGENT_TOKENS=
# Comma-separated agent IDs permitted to post rolling thread digests alongside Bridge
TOWER_SUMMARIZER_ACTORS=deepseek
